generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  password           String
  phone              String?
  birthdate          DateTime?
  points             Int       @default(0)
  personalCoupon     String?   @unique // <--- Campo para el código de descuento individual
  emailVerified      DateTime? // Fecha de verificación del correo
  subscribedToPromos Boolean   @default(true) // Suscrito a ofertas y promociones
  orders             Order[]
  carts              Cart[]
  createdAt          DateTime  @default(now())
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total          Float
  discount       Float       @default(0) // <--- Nuevo campo para guardar el descuento aplicado
  coupon         String?                 // <--- Nuevo campo para guardar el código del cupón usado
  status         String      @default("Pendiente")
  shippingMethod String
  paymentMethod  String
  createdAt      DateTime    @default(now())
  items          OrderItem[]
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name     String
  price    Float
  quantity Int
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Float
  oldPrice    Float?
  stock       Int
  category    String
  brand       String?
  sizes       String[]
  images      String?  // <--- Imagenes múltiples
  image       String?  // <--- Imagen 1 de respaldo para la portada y tarjetas del catálogo
  description String?
  isPromo     Boolean  @default(false)
  isDiscount  Boolean  @default(false)
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
}

model PageView {
  id        String   @id @default(uuid())
  path      String   @default("/")
  createdAt DateTime @default(now())
}